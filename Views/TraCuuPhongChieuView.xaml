<Window x:Class="Cinema_Management_App.Views.TraCuuPhongChieuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cinema_Management_App.Views"
        mc:Ignorable="d"
        Title="Tra Cứu Phòng Chiếu" Height="650" Width="1200"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Name="wdTraCuu">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
        <Style TargetType="ComboBox" >
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF9DEB86"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF86D672"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#e9e9e9" BorderBrush="#666" BorderThickness="1" Padding="20" Margin="10,10,10,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" VerticalAlignment="Center">
                <Label Content="Tra cứu phòng chiếu" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"/>

                <Button x:Name="ButtonClose" Content="X" Command="{Binding ThoatCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Height="30" Width="40" FontSize="24" FontFamily="Bahnschrift Light" 
                        FontWeight="Bold" Padding="0" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C4C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="10,0,10,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Mã phòng" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox Foreground="Gray" Text="{Binding MaPhongContain, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Tên phòng" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding TenPhongContain, UpdateSourceTrigger=PropertyChanged}" Foreground="Gray"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <Label Content="Loại phòng" FontSize="14" FontWeight="SemiBold"/>
                    <ComboBox SelectedIndex="0" ItemsSource="{Binding DanhSachLoaiPhong}"
                              DisplayMemberPath="TenLoaiPhong" 
                              SelectedItem="{Binding LoaiPhongDuocChon, UpdateSourceTrigger=PropertyChanged}">
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <Label Content="Tình trạng phòng" FontSize="14" FontWeight="SemiBold"/>
                    <ComboBox SelectedIndex="0" ItemsSource="{Binding DanhSachTinhTrangPhong}"
                              DisplayMemberPath="TenTinhTrangPhong" 
                              SelectedItem="{Binding TinhTrangDuocChon, UpdateSourceTrigger=PropertyChanged}">
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <Label Content="Ghi chú" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding GhiChuContain, UpdateSourceTrigger=PropertyChanged}" Foreground="Gray"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0,10,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Số lượng ghế" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="từ" Foreground="Red" Margin="5,0,10,0" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="2" Text="{Binding SoLuongGheTu, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="3" Text="đến" Foreground="Red" Margin="15,0,10,0" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="4" Text="{Binding SoLuongGheDen, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Tổng thành tiền" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="từ" Foreground="Red" Margin="5,0,10,0" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="2" Text="{Binding TongTienTu, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="3" Text="đến" Foreground="Red" Margin="15,0,10,0" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="4" Text="{Binding TongTienDen, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="15">
                <Button x:Name="ButtonTraCuu" Content="Tra cứu phòng chiếu" Style="{StaticResource RoundedButtonStyle}" Height="35" Width="180" FontSize="16" Margin="0,0,10,0" Command="{Binding TraCuuPhongChieuCommand}"/>
                <Button x:Name="ButtonThoat" Content="Thoát" Style="{StaticResource RoundedButtonStyle}" Background="#FFFF9393" Height="35" Width="95" FontSize="16" Margin="0,0,0,0" Command="{Binding ThoatCommand}"/>
            </StackPanel>
            <DataGrid Grid.Row="4" Margin="10,0,10,10" ItemsSource="{Binding DanhSachPhongChieuHopLe}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                      Background="White" BorderBrush="#DCDFE6" BorderThickness="1" GridLinesVisibility="Horizontal" RowHeight="45">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F7FA"/>
                        <Setter Property="Foreground" Value="#303133"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#DCDFE6"/>
                        <Setter Property="Padding" Value="10,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STT" Width="0.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding STT, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="35" FontSize="14"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="TÊN PHÒNG" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TenPhong, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="35" FontSize="14" 
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TenPhong}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="LOẠI PHÒNG" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LoaiPhong, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="35" FontSize="14"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding LoaiPhong}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="TÌNH TRẠNG PHÒNG" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TinhTrangPhong, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="35" FontSize="14"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TinhTrangPhong}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="SỐ LƯỢNG GHẾ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SoLuongGhe, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="35" FontSize="14"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SoLuongGhe}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="GHI CHÚ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" 
                                           Margin="5" Height="35" FontSize="14" 
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding GhiChu}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>