<UserControl x:Class="Cinema_Management_App.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:extensions="clr-namespace:Cinema_Management_App.Extensions"
             xmlns:local="clr-namespace:Cinema_Management_App.Views"
             mc:Ignorable="d" 
             d:DesignWidth="1200">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#ffffff">

        <StackPanel Margin="30">

            <TextBlock Text="Cài đặt" FontSize="28" FontWeight="Bold" Foreground="#303133"/>
            <TextBlock Text="Điều chỉnh các thông số và thiết lập cho ứng dụng" 
                       FontSize="15" Foreground="#909399" Margin="0,5,0,20"/>

            <Border Background="White" CornerRadius="8" BorderBrush="#DCDFE6" BorderThickness="1">

                <StackPanel Margin="20">

                    <StackPanel>
                        <TextBlock Text="Tham số" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="Thay đổi các tham só hệ thống" Foreground="#909399" Margin="0,0,0,15"/>
                        <Grid Margin="0, 10, 0, 10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mỗi ghế trong một suất chiếu chỉ được bán duy nhất 1 lần" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                            IsChecked="{Binding ThamSoChiBanGheMotLan}" />
                        </Grid>
                        <Grid Margin="0, 10, 0, 10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cho phép bán vé của các suất chiếu đã bắt đầu" 
                                       TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center"
                                       />
                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                    IsChecked="{Binding ThamSoBanVeSuatDaBatDau}" />
                        </Grid>
                        <Grid Margin="0, 10, 0, 10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cho phép các suất chiếu trong cùng phòng chiếu trùng thời gian" 
                   TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center"
                   />
                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                IsChecked="{Binding ThamSoSuatChieuTrungNhau}" />
                        </Grid>
                        <Grid Margin="0, 10, 0, 10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Có thời gian giãn cách giữa các suất chiếu trong cùng 1 phòng chiếu" 
TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center"
/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" 
             IsChecked="{Binding ThamSoSuatChieuPhaiGianCach}" />
                        </Grid>
                        <Grid Margin="0, 10, 0, 10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thời gian giãn cách tối thiểu" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox extensions:NumericInputBehavior.IsNumericOnly="True"  BorderThickness="1" Width="40" Text="{Binding ThamSoThoiGianToiThieuGiuaSuatChieu}" HorizontalContentAlignment="Center" FontSize="14"  IsEnabled="{Binding ThamSoSuatChieuPhaiGianCach}"/>
                                <TextBlock Text="phút" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            
                        </Grid>


                    </StackPanel>

                    <Separator Margin="0,20" Background="#E4E7ED"/>

                    <StackPanel>
                        <TextBlock Text="Khác" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    </StackPanel>

                    <Separator Margin="0,20" Background="#E4E7ED"/>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
