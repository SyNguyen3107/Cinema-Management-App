<Window x:Class="Cinema_Management_App.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:enums="clr-namespace:Cinema_Management_App.Enums"
        xmlns:local="clr-namespace:Cinema_Management_App.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Quản lý rạp phim" Height="800" Width="1280"
        MinWidth="300" MinHeight="480">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#303133"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#ffffff" BorderThickness="1" BorderBrush="Black">
            <StackPanel Margin="5, 200, 5, 100">
                <Button ToolTip="Màn hình chính" Margin="0, 20, 0, 20" Command="{Binding ChuyenTrangCommand}" 
                        CommandParameter="{x:Static enums:PageType.DASHBOARD}"
                        Height="30" Background="Transparent" BorderBrush="Transparent"
                        Padding="2">
                    <Image Source="/Resources/icon/home.png"/>
                </Button>

                <Button ToolTip="Cài đặt" Command="{Binding ChuyenTrangCommand}" Margin="0, 20, 0, 20"
                            CommandParameter="{x:Static enums:PageType.SETTINGS}"
                            Height= "30" Background="Transparent" BorderBrush="Transparent"
                            Padding="2">
                    <Image Source="/Resources/icon/settings.png"/>
                </Button>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#f0f0f0">
            <Grid>
                <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#ffffff" BorderThickness="1" BorderBrush="Black">
                    <DockPanel Margin="20, 5, 20, 5">
                        <Button x:Name="ButtonClose" Content="X" Command="{Binding ThoatCommand}"
        HorizontalAlignment="Right" VerticalAlignment="Center" 
        Height="30" Width="30" FontSize="20" FontFamily="Bahnschrift Light" 
        FontWeight="Bold" Padding="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#909399"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F56C6C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding CurrentViewModelTitle}" FontSize="20" VerticalAlignment="Center" Margin="20, 0, 0, 0"/>
                <ContentControl Grid.Row="1"
                    Content="{Binding CurrentViewModel}" Margin="0, 20, 0, 20" 
                    />
            </Grid>
            
            
        </Border>
        
    </Grid>
</Window>
