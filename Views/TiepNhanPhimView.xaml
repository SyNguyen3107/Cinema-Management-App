<Window x:Class="Cinema_Management_App.Views.TiepNhanPhimView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="av" 
        Title="Tiếp nhận phim"
        Height="520" Width="764"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox" >
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF9DEB86"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF86D672"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#e9e9e9" BorderBrush="#666" BorderThickness="1" Padding="20" Margin="10,10,10,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Label Content="Tiếp nhận phim" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"/>
                <Button x:Name="ButtonClose" Content="X" Command="{Binding ThoatCommand}"
        HorizontalAlignment="Right" VerticalAlignment="Top" 
        Height="30" Width="40" FontSize="24" FontFamily="Bahnschrift Light" 
        FontWeight="Bold" BorderBrush="Transparent" Background="Transparent" 
        Foreground="#666666" Padding="0" Margin="0,0,10,0"/>
            </Grid>

            <Grid Grid.Row="1" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                    <Label Content="Tên phim" FontSize="14"/>
                    <TextBox x:Name="TextBoxTenPhim" Text="{Binding TenPhim}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                    <Label Content="Mã phim" FontSize="14"/>
                    <TextBox x:Name="TextBoxMaPhim" Background="#FFC6C6C6" IsReadOnly="True" Text="{Binding MaPhim}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                    <Label Content="Tên thể loại" FontSize="14"/>
                    <ComboBox x:Name="ComboBoxTenTheLoai" Width="158" HorizontalAlignment="Left"
                              ItemsSource="{Binding DanhSachTheLoai}" DisplayMemberPath="TenTheLoai" SelectedItem="{Binding TheLoaiDuocChon}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                    <Label Content="Thời lượng (phút)" FontSize="14"/>
                    <TextBox x:Name="TextBoxThoiLuong" HorizontalAlignment="Left" Width="124" Text="{Binding ThoiLuong}" PreviewTextInput="ChuyenDuyetNhapSo"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                    <Label Content="Tên đạo diễn" FontSize="14"/>
                    <TextBox x:Name="TextBoxTenDaoDien" Text="{Binding TenDaoDien}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
                    <Label Content="Tên diễn viên chính" FontSize="14"/>
                    <TextBox x:Name="TextBoxTenDienVienChinh" Text="{Binding TenDienVienChinh}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,15">
                    <Label Content="Tên nhãn phim" FontSize="14"/>
                    <ComboBox x:Name="ComboBoxTenNhanPhim" Width="158" HorizontalAlignment="Left"
                              ItemsSource="{Binding DanhSachNhanPhim}" DisplayMemberPath="TenNhanPhim" SelectedItem="{Binding NhanPhimDuocChon}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,15">
                    <Label Content="Ngày khởi chiếu" FontSize="14"/>
                    <DatePicker x:Name="DatePickerNgayKhoiChieu" SelectedDate="{Binding NgayKhoiChieu, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <Line Grid.Row="2" X1="0" Y1="0" X2="2" Y2="0" Stretch="Fill" Stroke="#CCCCCC" StrokeThickness="2" Margin="10, 0, 10, 0"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="ButtonThoat" Content="Thoát" Style="{StaticResource RoundedButtonStyle}" Background="#FFFF9393" Height="35" Width="95" FontSize="16" Margin="0,0,10,0" Command="{Binding ThoatCommand}"/>
                <Button x:Name="ButtonDatLai" Content="Đặt lại" Style="{StaticResource RoundedButtonStyle}" Background="White" Height="35" Width="95" FontSize="16" Margin="0,0,10,0" Command="{Binding DatLaiCommand}"/>
                <Button x:Name="ButtonXoaPhim" Content="Xóa phim" Style="{StaticResource RoundedButtonStyle}" Background="White" Height="35" Width="95" FontSize="16" Margin="0,0,10,0" Command="{Binding XoaPhimCommand}"/>
                <Button x:Name="ButtonCapNhatPhim" Content="Cập nhật phim" Style="{StaticResource RoundedButtonStyle}" Background="White" Height="35" Width="135" FontSize="16" Margin="0,0,10,0" Command="{Binding CapnhatPhimCommand}"/>
                <Button x:Name="ButtonTimPhim" Content="Tìm phim" Style="{StaticResource RoundedButtonStyle}" Background="White" Height="35" Width="95" FontSize="16" Margin="0,0,10,0" Command="{Binding TimPhimCommand}"/>
                <Button x:Name="ButtonTiepNhan" Content="Tiếp nhận" Style="{StaticResource RoundedButtonStyle}" Height="35" Width="95" FontSize="16" Command="{Binding TiepNhanCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>