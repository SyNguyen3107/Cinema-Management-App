<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" mc:Ignorable="av" x:Class="Cinema_Management_App.Views.TiepNhanPhimView"
        Title="Tiếp nhận phim"
    
        Height="495" Width="764"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" 
                                CornerRadius="8" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7EB4EA"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF569DE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="templateRoot" CornerRadius="8" Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition MaxWidth="30" Width="0.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                    <ContentPresenter Grid.Column="0" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Fill="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                <Border x:Name="dropDownBorder" Background="White" BorderBrush="#666" BorderThickness="1" CornerRadius="5" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF9DEB86"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF86D672"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border CornerRadius="15"
            Background="#e9e9e9"
            BorderBrush="#666"
            BorderThickness="1"
            Padding="2" Margin="0,0,0,57">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid ClipToBounds="True" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="324*"/>
            </Grid.RowDefinitions>
            <Label Content="Tên phim" HorizontalAlignment="Left" Margin="34,0,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <TextBox x:Name="TextBoxTenPhim" HorizontalAlignment="Left" Margin="34,34,0,0" VerticalAlignment="Top" Width="316" Height="31" BorderBrush="#FF6EA3ED" Grid.Row="1" FontSize="15" Text="{Binding TenPhim}"/>
            <Label Content="Tên thể loại" HorizontalAlignment="Left" Margin="34,70,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <dxe:ComboBoxEdit x:Name="ComboBoxTenTheLoai"
                  CornerRadius="8"
                  HorizontalAlignment="Left" 
                  Margin="34,98,0,0" 
                  VerticalAlignment="Top" 
                  Width="316" Height="Auto" 
                  MinHeight="31"
                  BorderBrush="#FF6EA3ED" 
                  Grid.Row="1" 
                  FontSize="15"
                  ValidateOnTextInput="False"
                  IncrementalFiltering="True"
                  ImmediatePopup="True"
                  ItemsSource="{Binding ListTheLoai}" 
                  EditValue="{Binding SelectedTheLoai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <dxe:ComboBoxEdit.StyleSettings>
                    <dxe:TokenComboBoxStyleSettings NewTokenPosition="Far" 
                                        EnableTokenWrapping="True" 
                                        ShowTokenButtons="True"
                                        AllowEditTokens="True"/>
                </dxe:ComboBoxEdit.StyleSettings>
            </dxe:ComboBoxEdit>

            <Label Content="Tên đạo diễn" HorizontalAlignment="Left" Margin="34,135,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <TextBox x:Name="TextBoxTenDaoDien" HorizontalAlignment="Left" Margin="34,164,0,0" VerticalAlignment="Top" Width="316" Height="31" BorderBrush="#FF6EA3ED" Grid.Row="1" FontSize="15" Text="{Binding TenDaoDien}"/>

            <Label Content="Tên nhãn phim" HorizontalAlignment="Left" Margin="34,200,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <ComboBox x:Name="ComboBoxTenNhanPhim" HorizontalAlignment="Left" Margin="34,228,0,0" VerticalAlignment="Top" Width="158" Height="31" BorderBrush="#FF6EA3ED" Grid.Row="1" FontSize="15" Foreground="#FFAC8686" Background="#FFBBBBBB" ItemsSource="{Binding TenNhanPhim}"/>

            <Label Content="Mã phim" HorizontalAlignment="Left" Margin="401,0,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <TextBox x:Name="TextBoxMaPhim" HorizontalAlignment="Left" Margin="401,34,0,0" VerticalAlignment="Top" Width="316" Height="31" Background="#FFC6C6C6" FontSize="15" IsReadOnly="True" BorderBrush="#FF6EA3ED" Grid.Row="1" Text="{Binding MaPhim}"/>

            <Label Content="Thời lượng" HorizontalAlignment="Left" Margin="401,70,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <TextBox x:Name="TextBoxThoiLuong" HorizontalAlignment="Left" Margin="401,98,0,0" VerticalAlignment="Top" Width="124" Height="31" BorderBrush="#FF6EA3ED" Grid.Row="1" FontSize="15" Text="{Binding ThoiLuong}"/>

            <Label Content="Tên diễn viên chính" HorizontalAlignment="Left" Margin="401,135,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <TextBox x:Name="TextBoxTenDienVienChinh" HorizontalAlignment="Left" Margin="401,164,0,0" VerticalAlignment="Top" Width="316" Height="31" BorderBrush="#FF6EA3ED" Grid.Row="1" FontSize="15" Text="{Binding TenDienVienChinh}"/>
            
            <Label Content="Ngày khởi chiếu" HorizontalAlignment="Left" Margin="401,200,0,0" VerticalAlignment="Top" FontSize="14" Grid.Row="1"/>
            <DatePicker x:Name="DatePickerNgayKhoiChieu" HorizontalAlignment="Left" Margin="401,228,0,0" VerticalAlignment="Top" Width="316" Height="31" FontSize="15" SelectedDateFormat="Short" Grid.Row="1" SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}">
                <DatePicker.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                        <GradientStop Color="#FFA3AEB9"/>
                        <GradientStop Color="#FF8399A9" Offset="0.375"/>
                        <GradientStop Color="#FF718597" Offset="0.375"/>
                        <GradientStop Color="#FF6EA3ED" Offset="1"/>
                    </LinearGradientBrush>
                </DatePicker.BorderBrush>
            </DatePicker>
            <Grid Grid.Row="0">
                <Label Content="Tiếp nhận phim" HorizontalAlignment="Left" Margin="27,0,0,0" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"/>
                <Button x:Name="ButtonClose" Content="X" HorizontalAlignment="Left" Margin="700,15,0,0" VerticalAlignment="Top" Height="30" Width="40" FontSize="24" FontFamily="Bahnschrift Light" FontWeight="Bold" BorderBrush="#00000000" Background="#00000000"/>
            </Grid>
            <Button x:Name="ButtonTiepNhan" Content="Tiếp nhận"
        Style="{StaticResource RoundedButtonStyle}"
        HorizontalAlignment="Left"
        Margin="635,301,0,10"
        Height="31"
        Width="95"
        FontSize="16" BorderBrush="#FF6EA3ED" Grid.Row="1"
        Command="{Binding TiepNhanCommand}"/>
            <Button x:Name="ButtonThoat" Content="Thoát"
        Style="{StaticResource RoundedButtonStyle}"
        Background="#FFFF9393"
        HorizontalAlignment="Left"
        Margin="31,301,0,10"
        Height="31"
        Width="95"
        FontSize="16" BorderBrush="#FF6EA3ED" Grid.Row="1"
        Command="{Binding ThoatCommand}"/>
            <Button x:Name="ButtonDatLai" Content="Đặt lại"
                Style="{StaticResource RoundedButtonStyle}"
                Background="White"
                HorizontalAlignment="Left"
                Margin="145,301,0,10"
                Height="31"
                Width="94"
                FontSize="16" BorderBrush="#FF6D6DF9" Grid.Row="1"
                Command="{Binding DatLaiCommand}"/>
            <Button x:Name="ButtonXoaPhim" Content="Xóa phim"
                Style="{StaticResource RoundedButtonStyle}"
                Background="White"
                HorizontalAlignment="Left"
                Margin="255,301,0,10"
                Height="31"
                Width="95"
                FontSize="16" BorderBrush="#FF6D6DF9" Grid.Row="1"
                Command="{Binding XoaPhimCommand}"/>
            <Button x:Name="ButtonCapNhatPhim" Content="Cập nhật phim"
                Style="{StaticResource RoundedButtonStyle}"
                Background="White"
                HorizontalAlignment="Left"
                Margin="366,301,0,10"
                Height="31"
                Width="135"
                FontSize="16" BorderBrush="#FF6D6DF9" Grid.Row="1"
                Command="{Binding CapnhatPhimCommand}"/>
            <Button x:Name="ButtonTimPhim" Content="Tìm phim"
                Style="{StaticResource RoundedButtonStyle}"
                Background="White"
                HorizontalAlignment="Left"
                Margin="520,301,0,10"
                Height="31"
                Width="96"
                FontSize="16" BorderBrush="#FF6D6DF9" Grid.Row="1"
                Command="{Binding TimPhimCommand}"/>
        </Grid>
    </Border>
</Window>