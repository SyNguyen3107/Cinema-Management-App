<Window x:Class="Cinema_Management_App.Views.LapSuatChieuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cinema_Management_App.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Lập Suất Chiếu" Height="Auto" Width="800"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Name="wdLapSuatChieu">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox" >
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#F4F6F8" BorderBrush="#DCDFE6" BorderThickness="1" Padding="25" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Direction="270"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" VerticalAlignment="Center">
                <Label Content="LẬP SUẤT CHIẾU" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#303133"/>

                <Button x:Name="ButtonClose" Content="X" Command="{Binding ThoatCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Height="30" Width="30" FontSize="20" FontFamily="Bahnschrift Light" 
                        FontWeight="Bold" Padding="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#909399"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F56C6C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" >
                        <Label Content="Mã suất chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MaSuatChieu, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#909399" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Tên phim" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding DanhSachPhim}" DisplayMemberPath="TenPhim" SelectedItem="{Binding PhimDuocChon, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Thời lượng" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ThoiLuong, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Tên phòng chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding DanhSachPhongChieu}" DisplayMemberPath="TenPhong" SelectedItem="{Binding PhongDuocChon, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Loại phòng chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding LoaiPhongChieu, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Tình trạng phòng" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TinhTrangPhong, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Số lượng ghế" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SoLuongGhe, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Ngày chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding NgayChieu, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Giờ bắt đầu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <materialDesign:TimePicker SelectedTime="{Binding GioBatDau, UpdateSourceTrigger=PropertyChanged}" 
                               Is24Hours="True" 
                               Height="40" FontSize="15" Background="White" Padding="10,0" BorderBrush="#DCDFE6" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <Label Content="Giờ kết thúc" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <materialDesign:TimePicker SelectedTime="{Binding GioKetThuc, UpdateSourceTrigger=PropertyChanged}" 
                               Is24Hours="True" 
                               Height="40" FontSize="15" Background="White" Padding="10,0" BorderBrush="#DCDFE6" BorderThickness="1"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Line Grid.Row="2" X1="0" Y1="0" X2="2" Y2="0" Stretch="Fill" Stroke="#DCDFE6" StrokeThickness="1" Margin="0, 15, 0, 20"/>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button x:Name="ButtonThoat" Content="Thoát" Style="{StaticResource RoundedButtonStyle}" 
                            Background="#F56C6C" Foreground="White" FontWeight="Bold" Height="40" Width="100" FontSize="16" Margin="0,0,15,0" 
                            Command="{Binding ThoatCommand}"/>

                    <Button x:Name="ButtonTimPhong" Content="Tra cứu phòng chiếu" Style="{StaticResource RoundedButtonStyle}" 
                            Background="#409EFF" Foreground="White" FontWeight="Bold" Height="40" Width="180" FontSize="16" 
                            Command="{Binding TraCuuPhongChieuCommand}"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="ButtonLapSuat" Content="Lập suất chiếu" Style="{StaticResource RoundedButtonStyle}" 
                        Background="#67C23A" Foreground="White" FontWeight="Bold" Height="40" Width="150" FontSize="16" 
                        Command="{Binding LapSuatChieuCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>