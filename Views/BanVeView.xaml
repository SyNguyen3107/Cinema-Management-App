<Window x:Class="Cinema_Management_App.Views.BanVeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cinema_Management_App.Views"
        mc:Ignorable="d"
        Title="Bán Vé" Height="900" Width="800"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Name="wdBanVe">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#303133"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#F4F6F8" BorderBrush="#DCDFE6" BorderThickness="1" Padding="25" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Direction="270"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" VerticalAlignment="Center">
                <Label Content="BÁN VÉ" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#303133"/>

                <Button x:Name="ButtonClose" Content="X" Command="{Binding ThoatCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Height="30" Width="30" FontSize="20" FontFamily="Bahnschrift Light" 
                        FontWeight="Bold" Padding="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#909399"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F56C6C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Mã suất chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding DanhSachSuatChieu}" DisplayMemberPath="MaSuatChieu" SelectedItem="{Binding SuatChieuDuocChon, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Mã vé" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MaVe, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#909399" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Tên phim" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TenPhim, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Tên phòng chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TenPhong, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Ngày chiếu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NgayChieu, StringFormat='dd/MM/yyyy', Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Giờ bắt đầu" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding GioBatDau, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <Label Content="Giờ kết thúc" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding GioKetThuc, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#606266" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Ngày bán" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding NgayBan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Tên nhân viên bán" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TenNhanVienBan, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Hình thức thanh toán" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HinhThucThanhToan, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Tổng tiền" FontSize="15" FontWeight="SemiBold" Foreground="#606266" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TongTien, StringFormat={}{0:N0} VNĐ, Mode=OneWay}" IsReadOnly="True" Background="#E4E7ED" Foreground="#F56C6C" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachGheChon}" AutoGenerateColumns="False" CanUserAddRows="False" 
          Margin="0,10,0,10" Background="White" BorderBrush="#DCDFE6" BorderThickness="1" GridLinesVisibility="Horizontal" RowHeight="45">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F7FA"/>
                        <Setter Property="Foreground" Value="#303133"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#DCDFE6"/>
                        <Setter Property="Padding" Value="10,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="STT" Width="0.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding STT}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="MÃ SỐ GHẾ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.DanhSachGheTrong, RelativeSource={RelativeSource AncestorType=Window}}" 
                              DisplayMemberPath="MaSoGhe"
                              SelectedItem="{Binding GheDuocChon, UpdateSourceTrigger=PropertyChanged}" 
                               FontSize="14"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TÊN LOẠI GHẾ" Width="*" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GheDuocChon.LoaiGhe, UpdateSourceTrigger=PropertyChanged}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ĐƠN GIÁ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GheDuocChon.DonGia, StringFormat={}{0:N0} VNĐ, UpdateSourceTrigger=PropertyChanged}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" FontWeight="Bold" FontSize="16" Height="35" Width="Auto"
                            Command="{Binding DataContext.XoaGheCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                            CommandParameter="{Binding}" Foreground="#F56C6C" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="3" Command="{Binding ThemGheCommand}" Content="+" FontSize="24" FontWeight="Bold" Width="Auto" Height="40" Margin="0,0,0,15" Background="#F2F6FC" BorderBrush="#DCDFE6" Foreground="#909399" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E4E7ED"/>
                                <Setter Property="Foreground" Value="#606266"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Line Grid.Row="4" X1="0" Y1="0" X2="2" Y2="0" Stretch="Fill" Stroke="#DCDFE6" StrokeThickness="1" Margin="0, 0, 0, 20"/>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button x:Name="ButtonThoat" Content="Thoát" Style="{StaticResource RoundedButtonStyle}" 
                            Background="#F56C6C" Height="40" Width="100" FontSize="16" Margin="0,0,15,0" 
                            Command="{Binding ThoatCommand}" Cursor="Hand"/>

                    <Button x:Name="ButtonTraCuu" Content="Tra cứu phòng chiếu" Style="{StaticResource RoundedButtonStyle}" 
                            Background="#409EFF" Height="40" Width="200" FontSize="16" Margin="0,0,15,0" 
                            Command="{Binding TraCuuPhongChieuCommand}" Cursor="Hand"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="ButtonBanVe" Content="Bán vé" Style="{StaticResource RoundedButtonStyle}" 
                        Background="#67C23A" Height="40" Width="140" FontSize="16" 
                        Command="{Binding BanVeCommand}" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>