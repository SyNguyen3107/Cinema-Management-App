<Window x:Class="Cinema_Management_App.Views.LapDanhSachPhongChieuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cinema_Management_App.Views"
        mc:Ignorable="d"
        Title="Lập Danh Sách Phòng Chiếu" Height="Auto" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5"
        Name="wdLapDanhSach">
    <Border Background="White" CornerRadius="10" BorderBrush="#DCDFE6" BorderThickness="1"  VerticalAlignment="Stretch">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="LẬP DANH SÁCH PHÒNG CHIẾU" FontSize="20" FontWeight="Bold" Foreground="#303133"/>
                <Button Content="X" 
                        Command="{Binding ThoatCommand}" 
                        CommandParameter="{Binding ElementName=wdLapDanhSach}"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" Width="30" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,5,10,10">
                    <TextBlock Text="Mã phòng" Margin="0,0,0,5"/>
                    <TextBox IsReadOnly="True" Background="#E4E7ED" Padding="5" Text="{Binding MaPhong, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,5,0,10">
                    <TextBlock Text="Tên phòng" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TenPhong, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,5,10,10">
                    <TextBlock Text="Tên Loại phòng" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DanhSachLoaiPhong}" 
          DisplayMemberPath="TenLoaiPhong" 
          SelectedItem="{Binding LoaiPhongDuocChon, UpdateSourceTrigger=PropertyChanged}" 
          Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,0,10">
                    <TextBlock Text="Tên Tình trạng phòng" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DanhSachTinhTrangPhong}" SelectedItem="{Binding ChonTinhTrang, UpdateSourceTrigger=PropertyChanged}" 
                              DisplayMemberPath="TenTinhTrang" Padding="5">
                        
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,5,10,10" Grid.ColumnSpan="2">
                    <TextBlock Text="Ghi chú" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" Padding="5" Height="35"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachGhe}" AutoGenerateColumns="False" CanUserAddRows="False" 
          LoadingRow="DataGrid_LoadingRow" Background="White" BorderBrush="#DCDFE6" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="MÃ GHẾ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding MaSoGhe, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TÊN LOẠI GHẾ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ListLoaiGheKhaDung, RelativeSource={RelativeSource AncestorType=Window}}" 
                      DisplayMemberPath="TenLoaiGhe"
                      SelectedItem="{Binding LoaiGheDuocChon, UpdateSourceTrigger=PropertyChanged}" 
                      Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ĐƠN GIÁ" 
                    Binding="{Binding LoaiGheDuocChon.DonGia, StringFormat={}{0:N0} VNĐ, UpdateSourceTrigger=PropertyChanged}" 
                    Width="*" 
                    IsReadOnly="True"/>

                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" 
                                        Command="{Binding DataContext.XoaGheCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Foreground="Red" Background="Transparent" BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="3" Command="{Binding ThemGheCommand}" Content="+" FontSize="20" Width="auto" Height="30" Margin="0,10" Background="#F2F6FC" BorderBrush="#DCDFE6"/>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Button Content="Thoát" 
                        Command="{Binding ThoatCommand}" 
                        CommandParameter="{Binding ElementName=wdLapDanhSach}"
                        HorizontalAlignment="Left" Width="100" Padding="8" Background="#409EFF" Foreground="White" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Phòng chiếu mới" Command="{Binding PhongChieuMoiCommand}" Width="150" Padding="8" Margin="0,0,10,0" Background="#409EFF" FontWeight="Bold" Foreground="White"/>
                    <Button Content="Lưu thông tin" Command="{Binding LuuThongTinCommand}" Width="120" Padding="8" Background="#409EFF" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>