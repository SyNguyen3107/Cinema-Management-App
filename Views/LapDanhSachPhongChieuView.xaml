<Window x:Class="Cinema_Management_App.Views.LapDanhSachPhongChieuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cinema_Management_App.Views"
        mc:Ignorable="d"
        Title="Lập Danh Sách Phòng Chiếu" Height="700" Width="850"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Name="wdLapDanhSach">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox" >
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF9DEB86"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF86D672"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#e9e9e9" BorderBrush="#666" BorderThickness="1" Padding="20" Margin="10,10,10,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" VerticalAlignment="Center">
                <Label Content="Lập danh sách phòng chiếu" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"/>

                <Button x:Name="ButtonClose" Content="X" Command="{Binding ThoatCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Height="30" Width="40" FontSize="24" FontFamily="Bahnschrift Light" 
                        FontWeight="Bold" Padding="0" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C4C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="10,0,10,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                    <Label Content="Mã phòng" FontSize="14"/>
                    <TextBox IsReadOnly="True" Background="#FFC6C6C6" Text="{Binding MaPhong, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                    <Label Content="Tên phòng" FontSize="14"/>
                    <TextBox Text="{Binding TenPhong, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                    <Label Content="Loại phòng" FontSize="14"/>
                    <ComboBox ItemsSource="{Binding DanhSachLoaiPhong}" 
                              DisplayMemberPath="TenLoaiPhong" 
                              SelectedItem="{Binding LoaiPhongDuocChon, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                    <Label Content="Tình trạng phòng" FontSize="14"/>
                    <ComboBox ItemsSource="{Binding DanhSachTinhTrangPhong}" 
                              SelectedItem="{Binding ChonTinhTrang, UpdateSourceTrigger=PropertyChanged}" 
                              DisplayMemberPath="TenTinhTrangPhong"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,5">
                    <Label Content="Ghi chú" FontSize="14"/>
                    <TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachGhe}" AutoGenerateColumns="False" CanUserAddRows="False" 
                      Margin="10,0,10,10" Background="White" BorderBrush="#DCDFE6" GridLinesVisibility="Horizontal" RowHeight="45">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="MÃ SỐ GHẾ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding MaSoGhe, UpdateSourceTrigger=PropertyChanged}" Margin="5" Height="35" FontSize="14"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TÊN LOẠI GHẾ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ListLoaiGheKhaDung, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          DisplayMemberPath="TenLoaiGhe"
                                          SelectedItem="{Binding LoaiGheDuocChon, UpdateSourceTrigger=PropertyChanged}" 
                                          Margin="5" Height="35" FontSize="14"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ĐƠN GIÁ" 
                                        Binding="{Binding LoaiGheDuocChon.DonGia, StringFormat={}{0:N0} VNĐ, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="*" 
                                        IsReadOnly="True"/>

                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" FontWeight="Bold" FontSize="16" Height="35" Width="35"
                                        Command="{Binding DataContext.XoaGheCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Foreground="Red" Background="Transparent" BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="3" Command="{Binding ThemGheCommand}" Content="+" FontSize="24" FontWeight="Bold" Width="Auto" Height="40" Margin="0,0,0,15" Background="#F2F6FC" BorderBrush="#DCDFE6" Foreground="#606266"/>

            <Line Grid.Row="4" X1="0" Y1="0" X2="2" Y2="0" Stretch="Fill" Stroke="#CCCCCC" StrokeThickness="2" Margin="10, 0, 10, 0"/>

            <Grid Grid.Row="5" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button x:Name="ButtonThoat" Content="Thoát" Style="{StaticResource RoundedButtonStyle}" Background="#FFFF9393" Height="35" Width="95" FontSize="16" Margin="0,0,10,0" Command="{Binding ThoatCommand}"/>
                    <Button x:Name="ButtonDatLai" Content="Phòng chiếu mới" Style="{StaticResource RoundedButtonStyle}" Background="White" Height="35" Width="150" FontSize="16" Margin="0,0,10,0" Command="{Binding PhongChieuMoiCommand}"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="ButtonLuu" Content="Lưu thông tin" Style="{StaticResource RoundedButtonStyle}" Height="35" Width="130" FontSize="16" Command="{Binding LuuThongTinCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>